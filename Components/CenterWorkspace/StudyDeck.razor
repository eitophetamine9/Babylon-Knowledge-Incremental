@inject StudySessionState State
@implements IDisposable

<div class="p-5 flex flex-col gap-4 bg-[var(--color-card)] rounded-xl border border-[var(--color-card-border)] shadow-card transition-colors duration-300" aria-label="Active study session">
    <!-- Header row -->
    <div class="flex items-center justify-between flex-wrap gap-2">
        <div class="flex items-center gap-3">
            <h2 class="font-heading text-base font-bold text-[var(--color-text-primary)]">Active Study Deck</h2>
            <!-- Hourglass Focus Timer Pill -->
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-gold-light border border-gold/40 text-xs font-semibold text-gold-dark dark:text-gold shadow-sm">
                <span class="@(isTimerRunning ? "animate-spin" : "")" style="animation-duration: 3s;" aria-hidden="true">⏳</span>
                <span class="font-mono font-bold tracking-wider">@FormatTimer(timerSecondsRemaining)</span>
                <button type="button"
                        class="p-0.5 hover:text-black dark:hover:text-white transition-colors text-xs font-bold"
                        @onclick="ToggleTimer"
                        title="@(isTimerRunning ? "Pause timer" : "Start timer")">
                    @(isTimerRunning ? "⏸" : "▶")
                </button>
                <button type="button"
                        class="p-0.5 hover:text-black dark:hover:text-white transition-colors text-xs"
                        @onclick="ResetTimer"
                        title="Reset timer">
                    ↺
                </button>
            </div>
        </div>

        <div class="flex items-center gap-2">
            <!-- Timer duration selector -->
            <div class="hidden sm:inline-flex items-center gap-1 bg-[var(--color-bg-alt)] p-1 rounded-md border border-[var(--color-card-border)] text-[0.65rem] font-bold">
                <button type="button" class="px-2 py-0.5 rounded @(initialMinutes == 25 ? "bg-gold text-black" : "text-[var(--color-text-muted)]")" @onclick="() => SetTimer(25)">25m</button>
                <button type="button" class="px-2 py-0.5 rounded @(initialMinutes == 15 ? "bg-gold text-black" : "text-[var(--color-text-muted)]")" @onclick="() => SetTimer(15)">15m</button>
                <button type="button" class="px-2 py-0.5 rounded @(initialMinutes == 5 ? "bg-gold text-black" : "text-[var(--color-text-muted)]")" @onclick="() => SetTimer(5)">5m</button>
            </div>

            <span class="text-xs font-bold text-gold tracking-wider">
                Card @(State.CurrentCardIndex + 1) of @Math.Max(1, State.TotalCards)
            </span>
        </div>
    </div>

    <!-- Timer completed banner notification -->
    @if (timerCompletedNotice)
    {
        <div class="p-2.5 rounded-lg bg-gold-light border border-gold text-center text-xs font-bold text-gold-dark dark:text-gold flex items-center justify-between gap-2 animate-bounce">
            <span>🎉 Focus Session Complete! +25 Capsules awarded to your treasury.</span>
            <button class="text-xs px-2 py-0.5 rounded bg-gold text-black font-bold" @onclick="DismissNotice">Claimed ✓</button>
        </div>
    }

    <!-- Mode tabs -->
    <div class="grid grid-cols-2 gap-2 bg-[var(--color-bg-alt)] p-1 rounded-lg border border-[var(--color-card-border)]" role="tablist" aria-label="Study mode">
        <button id="tab-flashcards"
                class="py-2 px-3 rounded-md text-xs font-heading font-bold tracking-wider uppercase transition-all duration-200 @(State.IsFlashcardMode
                    ? "bg-gold text-black shadow-sm"
                    : "text-[var(--color-text-muted)] hover:text-[var(--color-text-primary)]")"
                role="tab"
                aria-selected="@State.IsFlashcardMode"
                @onclick="State.SwitchToFlashcards">
            🗃️ Flashcards
        </button>
        <button id="tab-quiz"
                class="py-2 px-3 rounded-md text-xs font-heading font-bold tracking-wider uppercase transition-all duration-200 @(!State.IsFlashcardMode
                    ? "bg-gold text-black shadow-sm"
                    : "text-[var(--color-text-muted)] hover:text-[var(--color-text-primary)]")"
                role="tab"
                aria-selected="@(!State.IsFlashcardMode)"
                @onclick="State.SwitchToQuiz">
            ❓ Quiz Trial
        </button>
    </div>

    <!-- Study content area -->
    @if (State.IsFlashcardMode)
    {
        @if (State.CurrentFlashcard is {} card)
        {
            <!-- 3D flip card -->
            <div class="card-scene"
                 id="flashcard-@card.Id"
                 @onclick="State.FlipCurrentCard"
                 role="button"
                 tabindex="0"
                 aria-label="@(card.IsFlipped ? "Answer: " + card.Answer : "Question: " + card.Question + ". Click to reveal.")"
                 @onkeydown="HandleCardKey">
                <div class="card-inner @(card.IsFlipped ? "flipped" : "")">
                    <!-- Front face (question) -->
                    <div class="card-face card-front">
                        <span class="card-tag font-caps">@card.Tag</span>
                        <span class="card-label text-gold font-caps">Question</span>
                        <p class="card-question">@card.Question</p>
                        <p class="card-hint text-muted">Reveal the answer or press space to flip</p>
                    </div>
                    <!-- Back face (answer) -->
                    <div class="card-face card-back">
                        <span class="card-tag font-caps">@card.Tag</span>
                        <span class="card-label text-gold font-caps">Answer</span>
                        <p class="card-answer">@card.Answer</p>
                    </div>
                </div>
            </div>

            <!-- Flashcard controls -->
            <div class="grid grid-cols-2 gap-3 pt-2">
                <button class="py-2.5 px-4 rounded-md border border-[var(--color-card-border)] hover:border-gold text-xs font-heading font-bold tracking-wider uppercase text-[var(--color-text-secondary)] hover:bg-gold-light transition-all flex items-center justify-center gap-2"
                        id="reveal-answer-btn"
                        @onclick="State.FlipCurrentCard">
                    <span aria-hidden="true">👁</span> Reveal Answer
                </button>
                <button class="py-2.5 px-4 rounded-md bg-lapis hover:bg-lapis-dark text-white text-xs font-heading font-bold tracking-wider uppercase transition-all shadow-sm flex items-center justify-center gap-2"
                        id="next-card-btn"
                        @onclick="State.NextCard">
                    <span>→</span> Next Card
                </button>
            </div>
        }
        else
        {
            <div class="p-8 text-center bg-[var(--color-bg-alt)] rounded-lg border border-[var(--color-card-border)] text-sm text-[var(--color-text-muted)]">
                <p>Generate flashcards from a PDF or load a scroll from the Library to begin studying.</p>
            </div>
        }
    }
    else
    {
        <!-- QUIZ MODE -->
        @if (IsQuizCompleted)
        {
            <!-- Quiz Results Celebration Card -->
            <div class="flex flex-col items-center justify-center p-6 sm:p-8 bg-[var(--color-bg-alt)] rounded-xl border border-gold shadow-gold text-center gap-4 animate-fade-in">
                <div class="text-4xl animate-bounce">🏆</div>
                <div class="flex flex-col gap-1">
                    <span class="text-xs font-bold text-gold uppercase tracking-widest">Trial Evaluation Completed</span>
                    <h3 class="font-heading text-xl font-bold text-[var(--color-text-primary)]">
                        @GetQuizEvaluationTitle()
                    </h3>
                    <p class="text-xs text-[var(--color-text-muted)]">
                        You scored <strong class="text-gold-dark dark:text-gold text-sm">@QuizCorrectCount of @State.QuizQuestions.Count</strong> (@QuizAccuracyPct% accuracy)
                    </p>
                </div>

                @if (!quizBountyClaimed)
                {
                    <div class="p-3 bg-gold-light border border-gold/50 rounded-lg flex items-center gap-3">
                        <span class="text-2xl">✨</span>
                        <div class="text-left">
                            <div class="text-xs font-bold text-gold-dark dark:text-gold">+@QuizCapsuleReward Capsules Bounty</div>
                            <div class="text-[0.68rem] text-[var(--color-text-muted)]">Scholarly mastery bounty for finishing the trial</div>
                        </div>
                        <button class="ml-2 px-3 py-1.5 rounded bg-gold hover:bg-gold-dark text-black font-heading text-xs font-bold uppercase transition-all shadow-sm"
                                @onclick="ClaimQuizBounty">
                            Claim
                        </button>
                    </div>
                }
                else
                {
                    <div class="text-xs font-bold text-green-600 dark:text-green-400 bg-green-100 dark:bg-green-950/40 border border-green-500/40 px-3 py-1.5 rounded-full">
                        ✓ +@QuizCapsuleReward Capsules Bounty Claimed!
                    </div>
                }

                <div class="grid grid-cols-2 gap-3 w-full max-w-xs pt-2">
                    <button class="py-2 px-3 rounded-md border border-gold/50 text-xs font-heading font-bold text-[var(--color-text-primary)] hover:bg-gold-light transition-all"
                            @onclick="RestartQuiz">
                        ↺ Retake Trial
                    </button>
                    <button class="py-2 px-3 rounded-md bg-lapis hover:bg-lapis-dark text-white text-xs font-heading font-bold transition-all shadow-sm"
                            @onclick="State.SwitchToFlashcards">
                        🗃️ Review Cards
                    </button>
                </div>
            </div>
        }
        else if (State.CurrentQuizQuestion is {} q)
        {
            <!-- Quiz question card -->
            <div class="flex flex-col gap-4 p-5 bg-[var(--color-bg-alt)] rounded-lg border border-[var(--color-card-border)]" id="quiz-@q.Id" role="group" aria-label="Quiz question @(State.CurrentCardIndex + 1)">
                <p class="font-heading text-sm font-semibold text-[var(--color-text-primary)] leading-relaxed">
                    @q.Prompt
                </p>

                <div class="flex flex-col gap-2" role="radiogroup" aria-label="Answer choices">
                    @for (int i = 0; i < q.Options.Count; i++)
                    {
                        var idx = i;
                        bool isCorrect = q.IsAnswered && idx == q.CorrectIndex;
                        bool isWrong = q.IsAnswered && idx == q.SelectedAnswerIndex && !q.IsCorrect;
                        bool isSelected = idx == q.SelectedAnswerIndex;

                        string borderClass = isCorrect ? "border-green-500 bg-green-50 dark:bg-green-950/30 text-green-900 dark:text-green-200"
                                           : isWrong   ? "border-red-500 bg-red-50 dark:bg-red-950/30 text-red-900 dark:text-red-200"
                                           : isSelected ? "border-gold bg-gold-light text-[var(--color-text-primary)]"
                                           : "border-[var(--color-card-border)] bg-[var(--color-card)] text-[var(--color-text-secondary)] hover:border-gold/60";

                        <label class="flex items-center gap-3 p-3 rounded-lg border @borderClass cursor-pointer transition-all duration-150 select-none" for="option-@q.Id-@idx">
                            <input type="radio"
                                   id="option-@q.Id-@idx"
                                   name="quiz-@q.Id"
                                   class="sr-only"
                                   checked="@(q.SelectedAnswerIndex == idx)"
                                   disabled="@q.IsAnswered"
                                   @onchange="() => State.SelectQuizAnswer(idx)" />
                            <span class="w-6 h-6 rounded-full flex items-center justify-center text-xs font-bold font-heading border border-current">
                                @((char)('A' + idx))
                            </span>
                            <span class="flex-1 text-xs font-medium">@q.Options[idx]</span>
                            @if (isCorrect)
                            {
                                <span class="text-green-600 font-bold" aria-label="Correct">✓</span>
                            }
                            else if (isWrong)
                            {
                                <span class="text-red-600 font-bold" aria-label="Wrong">✗</span>
                            }
                        </label>
                    }
                </div>

                @if (q.IsAnswered)
                {
                    <div class="p-2.5 rounded text-xs font-bold @(q.IsCorrect ? "bg-green-100 dark:bg-green-950/40 text-green-800 dark:text-green-300 border border-green-500/30" : "bg-red-100 dark:bg-red-950/40 text-red-800 dark:text-red-300 border border-red-500/30")">
                        @(q.IsCorrect ? "✅ Correct! Well done, Scholar." : "❌ Not quite. The correct answer is highlighted.")
                    </div>
                }
            </div>

            <!-- Quiz controls -->
            <div class="grid grid-cols-2 gap-3 pt-2">
                @if (!q.IsAnswered)
                {
                    <button class="col-span-2 py-2.5 px-4 rounded-md bg-lapis hover:bg-lapis-dark text-white text-xs font-heading font-bold tracking-wider uppercase transition-all shadow-sm disabled:opacity-50"
                            id="submit-answer-btn"
                            disabled="@(q.SelectedAnswerIndex < 0)"
                            @onclick="() => State.SelectQuizAnswer(q.SelectedAnswerIndex)">
                        Submit Answer
                    </button>
                }
                else
                {
                    <button class="col-span-2 py-2.5 px-4 rounded-md bg-lapis hover:bg-lapis-dark text-white text-xs font-heading font-bold tracking-wider uppercase transition-all shadow-sm"
                            id="next-question-btn"
                            @onclick="State.NextCard">
                        → Next Question
                    </button>
                }
            </div>
        }
        else
        {
            <div class="p-8 text-center bg-[var(--color-bg-alt)] rounded-lg border border-[var(--color-card-border)] text-sm text-[var(--color-text-muted)]">
                <p>Generate a quiz from a PDF to test your knowledge.</p>
            </div>
        }
    }
</div>

@code {
    private int initialMinutes = 25;
    private int timerSecondsRemaining = 25 * 60;
    private bool isTimerRunning = false;
    private bool timerCompletedNotice = false;
    private System.Threading.Timer? timer;
    private bool quizBountyClaimed = false;

    private bool IsQuizCompleted => State.QuizQuestions.Count > 0 && State.QuizQuestions.All(q => q.IsAnswered);
    private int QuizCorrectCount => State.QuizQuestions.Count(q => q.IsCorrect);
    private int QuizAccuracyPct => State.QuizQuestions.Count == 0 ? 0 : (int)Math.Round((double)QuizCorrectCount / State.QuizQuestions.Count * 100);
    private int QuizCapsuleReward => Math.Max(15, QuizCorrectCount * 15);

    protected override void OnInitialized()
    {
        State.OnChange += StateHasChanged;
    }

    private void SetTimer(int minutes)
    {
        initialMinutes = minutes;
        timerSecondsRemaining = minutes * 60;
        isTimerRunning = false;
        timer?.Dispose();
        timer = null;
    }

    private void ToggleTimer()
    {
        if (isTimerRunning)
        {
            isTimerRunning = false;
            timer?.Dispose();
            timer = null;
        }
        else
        {
            isTimerRunning = true;
            timer = new System.Threading.Timer(TimerCallback, null, 1000, 1000);
        }
    }

    private void ResetTimer()
    {
        isTimerRunning = false;
        timer?.Dispose();
        timer = null;
        timerSecondsRemaining = initialMinutes * 60;
    }

    private void TimerCallback(object? state)
    {
        if (timerSecondsRemaining > 0)
        {
            timerSecondsRemaining--;
            InvokeAsync(StateHasChanged);
        }
        else
        {
            isTimerRunning = false;
            timer?.Dispose();
            timer = null;
            timerCompletedNotice = true;
            State.AwardCapsules(25);
            InvokeAsync(StateHasChanged);
        }
    }

    private void DismissNotice()
    {
        timerCompletedNotice = false;
        ResetTimer();
    }

    private static string FormatTimer(int totalSeconds)
    {
        int mins = totalSeconds / 60;
        int secs = totalSeconds % 60;
        return $"{mins:D2}:{secs:D2}";
    }

    private string GetQuizEvaluationTitle() => QuizAccuracyPct switch
    {
        100 => "🏛️ Arch-Scholar of Babylon!",
        >= 66 => "📜 Master Scholar of the Codex!",
        _ => "🌱 Apprentice Scholar — Keep Pushing!"
    };

    private void ClaimQuizBounty()
    {
        if (!quizBountyClaimed)
        {
            quizBountyClaimed = true;
            State.AwardCapsules(QuizCapsuleReward);
        }
    }

    private void RestartQuiz()
    {
        quizBountyClaimed = false;
        State.ResetQuiz();
    }

    private void HandleCardKey(KeyboardEventArgs e)
    {
        if (e.Key is " " or "Enter")
            State.FlipCurrentCard();
        else if (e.Key == "ArrowRight")
            State.NextCard();
    }

    public void Dispose()
    {
        State.OnChange -= StateHasChanged;
        timer?.Dispose();
    }
}
