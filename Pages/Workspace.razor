@page "/"
@page "/workspace"
@inject StudySessionState State
@implements IDisposable

<PageTitle>Workspace — Babylon Knowledge Incremental</PageTitle>

<div class="workspace-grid">
    <!-- Column 1: Left Sidebar -->
    <aside class="workspace-col col-left" aria-label="Streak and tasks">
        <ErrorBoundary>
            <ChildContent><SisyphusStreak /></ChildContent>
            <ErrorContent Context="ex">
                <div class="component-error card">⚠️ Streak panel failed to load.</div>
            </ErrorContent>
        </ErrorBoundary>
        <ErrorBoundary>
            <ChildContent><TodoList /></ChildContent>
            <ErrorContent Context="ex">
                <div class="component-error card">⚠️ Task list failed to load.</div>
            </ErrorContent>
        </ErrorBoundary>
    </aside>

    <!-- Column 2: Center workspace -->
    <section class="workspace-col col-center" aria-label="Study workspace">
        <ErrorBoundary>
            <ChildContent><PdfDropzone /></ChildContent>
            <ErrorContent Context="ex">
                <div class="component-error card">⚠️ PDF dropzone failed to load.</div>
            </ErrorContent>
        </ErrorBoundary>
        <ErrorBoundary>
            <ChildContent><StudyDeck /></ChildContent>
            <ErrorContent Context="ex">
                <div class="component-error card">⚠️ Study deck failed to load.</div>
            </ErrorContent>
        </ErrorBoundary>
    </section>

    <!-- Column 3: Right progression -->
    <aside class="workspace-col col-right" aria-label="Tower progression">
        <ErrorBoundary>
            <ChildContent><TowerOfBabel /></ChildContent>
            <ErrorContent Context="ex">
                <div class="component-error card">⚠️ Tower failed to load.</div>
            </ErrorContent>
        </ErrorBoundary>
    </aside>
</div>

@code {
    protected override void OnInitialized()
        => State.OnChange += StateHasChanged;

    public void Dispose()
        => State.OnChange -= StateHasChanged;
}
