@page "/"
@page "/workspace"
@inject StudySessionState State
@implements IDisposable

<PageTitle>Workspace — Babylon Knowledge Incremental</PageTitle>

<div class="grid grid-cols-1 lg:grid-cols-[300px_1fr_270px] gap-6 items-start">
    <!-- Column 1: Left Sidebar -->
    <aside class="flex flex-col gap-6" aria-label="Streak and tasks">
        <ErrorBoundary>
            <ChildContent><SisyphusStreak /></ChildContent>
            <ErrorContent Context="ex">
                <div class="p-4 rounded-lg bg-[var(--color-card)] border border-red-400 text-sm text-red-500">⚠️ Streak panel failed to load.</div>
            </ErrorContent>
        </ErrorBoundary>
        <ErrorBoundary>
            <ChildContent><TodoList /></ChildContent>
            <ErrorContent Context="ex">
                <div class="p-4 rounded-lg bg-[var(--color-card)] border border-red-400 text-sm text-red-500">⚠️ Task list failed to load.</div>
            </ErrorContent>
        </ErrorBoundary>
    </aside>

    <!-- Column 2: Center workspace -->
    <section class="flex flex-col gap-6" aria-label="Study workspace">
        <ErrorBoundary>
            <ChildContent><PdfDropzone /></ChildContent>
            <ErrorContent Context="ex">
                <div class="p-4 rounded-lg bg-[var(--color-card)] border border-red-400 text-sm text-red-500">⚠️ PDF dropzone failed to load.</div>
            </ErrorContent>
        </ErrorBoundary>
        <ErrorBoundary>
            <ChildContent><StudyDeck /></ChildContent>
            <ErrorContent Context="ex">
                <div class="p-4 rounded-lg bg-[var(--color-card)] border border-red-400 text-sm text-red-500">⚠️ Study deck failed to load.</div>
            </ErrorContent>
        </ErrorBoundary>
    </section>

    <!-- Column 3: Right progression -->
    <aside class="flex flex-col gap-6" aria-label="Tower progression">
        <ErrorBoundary>
            <ChildContent><TowerOfBabel /></ChildContent>
            <ErrorContent Context="ex">
                <div class="p-4 rounded-lg bg-[var(--color-card)] border border-red-400 text-sm text-red-500">⚠️ Tower failed to load.</div>
            </ErrorContent>
        </ErrorBoundary>
    </aside>
</div>

@code {
    protected override void OnInitialized()
        => State.OnChange += StateHasChanged;

    public void Dispose()
        => State.OnChange -= StateHasChanged;
}
